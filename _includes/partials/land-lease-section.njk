{# =====================================================================
   Land-for-lease advert — full section for the Local Partners page.
   Include inside <main class="partners-wrapper">, before the
   "Become a Partner" CTA:
     {% endraw %}{% include "partials/land-lease-section.njk" %}{% raw %}
   Copy + contact live in _data/landAd.js (set active:false to switch it off).
   Styles are scoped with the .lls- prefix so they cannot clash with the
   partner-card rules already defined on the page.
   ===================================================================== #}
{% if landAd.active %}
{%- set t = landAd.i18n[lang] or landAd.i18n.en -%}

<section class="category-block reveal" id="land-for-lease">
  <div class="category-head">
    <span class="cat-icon" style="background-color:#2f8f4e;"><i class="fa-solid fa-map-location-dot" aria-hidden="true"></i></span>
    <h2>{{ t.catTitle }}</h2>
  </div>
  <p class="category-sub">{{ t.catSub }}</p>

  <article class="lls-card">
    <div class="lls-head">
      <span class="lls-badge"><i class="fa-solid fa-seedling" aria-hidden="true"></i> {{ t.badge }}</span>
      <h3 class="lls-title">{{ t.title }}</h3>
      <p class="lls-lead">{{ t.lead }}</p>
    </div>

    <div class="lls-grid">
      <div class="lls-copy">
        {%- for para in t.body %}
        <p>{{ para }}</p>
        {%- endfor %}

        <h4 class="lls-terms-title">{{ t.termsTitle }}</h4>
        <dl class="lls-terms">
          {%- for row in t.terms %}
          <div class="lls-term">
            <dt>{{ row[0] }}</dt>
            <dd>{{ row[1] }}</dd>
          </div>
          {%- endfor %}
        </dl>

        <p class="lls-direct"><i class="fa-solid fa-user-check" aria-hidden="true"></i> {{ t.directNote }}</p>

        <a class="lls-wa-btn" target="_blank" rel="noopener"
           href="https://wa.me/{{ landAd.whatsapp }}?text={{ t.waText | urlencode | safe }}">
          <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
          {{ t.cta }} · {{ landAd.whatsappDisplay }}
        </a>
      </div>

      <div class="lls-media">
        <figure class="lls-sat">
          <img src="{{ landAd.images.satellite }}" width="900" height="1491" loading="lazy" decoding="async"
               alt="Satellite view of the 425 m² plot for lease in Desa Ped, Nusa Penida, on the coast road in front of the beach">
          <figcaption>{{ t.satelliteCaption }}</figcaption>
        </figure>
        <figure>
          <img src="{{ landAd.images.certificate }}" width="900" height="793" loading="lazy" decoding="async"
               alt="Official land-office plot map showing the parcel on the Toya Pakeh – Ped main road">
          <figcaption>{{ t.certificateCaption }}</figcaption>
        </figure>
      </div>
    </div>
  </article>
</section>

<style>
  .lls-card{background:#fff;border-radius:14px;border:1px solid rgba(0,0,0,.05);border-top:4px solid #2f8f4e;box-shadow:0 10px 25px rgba(0,0,0,.05);padding:32px;overflow:hidden}
  .lls-head{max-width:820px}
  .lls-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(47,143,78,.1);color:#2f8f4e;font-family:var(--font-heading,sans-serif);font-weight:700;font-size:.72rem;letter-spacing:.5px;text-transform:uppercase;padding:6px 12px;border-radius:20px}
  .lls-title{font-size:1.6rem;line-height:1.3;color:var(--text-dark,#2C3E50);margin:14px 0 10px}
  .lls-lead{font-size:1.05rem;color:#555}

  .lls-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:36px;margin-top:28px;align-items:start}
  .lls-copy p{font-size:.96rem;color:#666;line-height:1.7;margin-bottom:14px}

  .lls-terms-title{font-size:1.05rem;color:var(--text-dark,#2C3E50);margin:24px 0 12px}
  .lls-terms{margin:0 0 20px}
  .lls-term{display:flex;gap:14px;padding:9px 0;border-bottom:1px solid #f0f0f0}
  .lls-term:last-child{border-bottom:none}
  .lls-term dt{flex:0 0 40%;font-weight:600;font-size:.9rem;color:#8a949a}
  .lls-term dd{margin:0;font-size:.93rem;color:var(--text-dark,#2C3E50)}

  .lls-direct{display:flex;align-items:flex-start;gap:10px;background:#f8f9fa;border-left:3px solid #FF7F50;border-radius:0 8px 8px 0;padding:12px 15px;font-size:.92rem;color:#555;margin-bottom:22px}
  .lls-direct i{color:#FF7F50;margin-top:4px;flex-shrink:0}

  .lls-wa-btn{display:flex;align-items:center;justify-content:center;gap:10px;background:#25D366;color:#fff;text-decoration:none;font-family:var(--font-heading,sans-serif);font-weight:700;font-size:1rem;padding:14px 20px;border-radius:30px;transition:background .3s,transform .2s}
  .lls-wa-btn:hover{background:#1da851;transform:translateY(-2px)}

  .lls-media{display:grid;gap:20px;align-content:start}
  .lls-media figure{margin:0}
  .lls-media img{display:block;width:100%;height:auto;border-radius:10px;border:1px solid #eee;background:#f3ece0}
  .lls-media figcaption{margin-top:9px;font-size:.83rem;color:#8a949a;line-height:1.5}
  /* The satellite shot is a tall phone screenshot — crop it so the two figures
     stay roughly the height of the copy beside them. */
  .lls-sat img{height:430px;object-fit:cover;object-position:center 32%}

  @media(max-width:820px){
    .lls-card{padding:24px 20px}
    .lls-title{font-size:1.3rem}
    .lls-lead{font-size:.98rem}
    .lls-grid{grid-template-columns:1fr;gap:28px;margin-top:22px}
    .lls-term{flex-direction:column;gap:2px}
    .lls-term dt{flex:none}
    .lls-sat img{height:230px;object-position:center 30%}
  }
</style>
{% endif %}
