{# =====================================================================
   Land & Investment — the listing cards, one per active entry in
   _data/landAd.js. Used by the /land-investment.html pages:
     {% endraw %}{% include "partials/land-listings.njk" %}{% raw %}
   Styles are scoped with the .lls- prefix.
   ===================================================================== #}
{% if landAd.active %}
<div class="lls-list">
  {%- for listing in landAd.openListings %}
  {%- set t = listing.i18n[lang] or listing.i18n.en -%}

  <article class="lls-card" id="{{ listing.id }}">
    <div class="lls-head">
      <span class="lls-badge"><i class="fa-solid fa-seedling" aria-hidden="true"></i> {{ t.badge }}</span>
      <h2 class="lls-title">{{ t.title }}</h2>
      <p class="lls-lead">{{ t.lead }}</p>
    </div>

    <div class="lls-grid">
      <div class="lls-copy">
        {%- for para in t.body %}
        <p>{{ para }}</p>
        {%- endfor %}

        <h3 class="lls-terms-title">{{ t.termsTitle }}</h3>
        <dl class="lls-terms">
          {%- for row in t.terms %}
          <div class="lls-term">
            <dt>{{ row[0] }}</dt>
            <dd>{{ row[1] }}</dd>
          </div>
          {%- endfor %}
        </dl>

        <p class="lls-direct"><i class="fa-solid fa-user-check" aria-hidden="true"></i> {{ t.directNote }}</p>

        <a class="lls-wa-btn" target="_blank" rel="noopener"
           href="https://wa.me/{{ listing.whatsapp }}?text={{ t.waText | urlencode | safe }}">
          <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
          {{ t.cta }} · {{ listing.whatsappDisplay }}
        </a>
      </div>

      <div class="lls-media">
        {%- for img in listing.gallery %}
        <figure{% if img.crop %} class="lls-sat"{% endif %}>
          <img src="{{ img.src }}" width="{{ img.w }}" height="{{ img.h }}" loading="lazy" decoding="async"
               alt="{{ img.alt }}">
          <figcaption>{{ t[img.captionKey] }}</figcaption>
        </figure>
        {%- endfor %}
      </div>
    </div>
  </article>

  {%- endfor %}
</div>

<style>
  .lls-list{display:grid;gap:40px}
  .lls-card{background:#fff;border-radius:14px;border:1px solid rgba(0,0,0,.05);border-top:4px solid #2f8f4e;box-shadow:0 10px 25px rgba(0,0,0,.05);padding:32px;overflow:hidden;scroll-margin-top:110px}
  .lls-head{max-width:820px}
  .lls-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(47,143,78,.1);color:#2f8f4e;font-family:var(--font-heading,sans-serif);font-weight:700;font-size:.72rem;letter-spacing:.5px;text-transform:uppercase;padding:6px 12px;border-radius:20px}
  .lls-title{font-size:1.6rem;line-height:1.3;color:var(--text-dark,#1f2a30);margin:14px 0 10px}
  .lls-lead{font-size:1.05rem;color:#555}

  .lls-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:36px;margin-top:28px;align-items:start}
  .lls-copy p{font-size:.96rem;color:#666;line-height:1.7;margin-bottom:14px}

  .lls-terms-title{font-size:1.05rem;color:var(--text-dark,#1f2a30);margin:24px 0 12px}
  .lls-terms{margin:0 0 20px}
  .lls-term{display:flex;gap:14px;padding:9px 0;border-bottom:1px solid #f0f0f0}
  .lls-term:last-child{border-bottom:none}
  .lls-term dt{flex:0 0 40%;font-weight:600;font-size:.9rem;color:#8a949a}
  .lls-term dd{margin:0;font-size:.93rem;color:var(--text-dark,#1f2a30)}

  .lls-direct{display:flex;align-items:flex-start;gap:10px;background:#f8f9fa;border-left:3px solid var(--secondary-color,#ff6b4a);border-radius:0 8px 8px 0;padding:12px 15px;font-size:.92rem;color:#555;margin-bottom:22px}
  .lls-direct i{color:var(--secondary-color,#ff6b4a);margin-top:4px;flex-shrink:0}

  .lls-wa-btn{display:flex;align-items:center;justify-content:center;gap:10px;background:#25D366;color:#fff;text-decoration:none;font-family:var(--font-heading,sans-serif);font-weight:700;font-size:1rem;padding:14px 20px;border-radius:30px;transition:background .3s,transform .2s}
  .lls-wa-btn:hover{background:#1da851;transform:translateY(-2px)}

  .lls-media{display:grid;gap:20px;align-content:start}
  .lls-media figure{margin:0}
  .lls-media img{display:block;width:100%;height:auto;border-radius:10px;border:1px solid #eee;background:#f3ece0}
  .lls-media figcaption{margin-top:9px;font-size:.83rem;color:#8a949a;line-height:1.5}
  /* The satellite shot is a tall phone screenshot — crop it so the two figures
     stay roughly the height of the copy beside them. */
  .lls-sat img{height:430px;object-fit:cover;object-position:center 32%}

  @media(max-width:820px){
    .lls-card{padding:24px 20px}
    .lls-title{font-size:1.3rem}
    .lls-lead{font-size:.98rem}
    .lls-grid{grid-template-columns:1fr;gap:28px;margin-top:22px}
    .lls-term{flex-direction:column;gap:2px}
    .lls-term dt{flex:none}
    .lls-sat img{height:230px;object-position:center 30%}
  }
</style>
{% endif %}
