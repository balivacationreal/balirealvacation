{# =====================================================================
   Land-for-lease advert — homepage welcome pop-up.
   Include near the end of a homepage content block:
     {% endraw %}{% include "partials/land-lease-modal.njk" %}{% raw %}
   Copy + contact live in _data/landAd.js (set active:false to switch it off).
   Hidden until /js/main.js-independent inline script opens it, so visitors
   with JS disabled — and anyone who already dismissed it — never see it.
   ===================================================================== #}
{% if landAd.active %}
{%- set t = landAd.i18n[lang] or landAd.i18n.en -%}
{%- set detailsUrl = (collections.i18nUrl['local-partners_' + lang] or '/local-partners.html') + landAd.detailsAnchor -%}

<div class="lla-overlay" id="lla-overlay" role="dialog" aria-modal="true"
     aria-labelledby="lla-title" aria-describedby="lla-lead" hidden>
  <div class="lla-card" role="document" id="lla-card" tabindex="-1">
    <button type="button" class="lla-close" id="lla-close" aria-label="{{ t.close }}">
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>

    <figure class="lla-media">
      <img src="{{ landAd.images.satellite }}" width="900" height="1491" loading="eager" fetchpriority="low" decoding="async"
           alt="Satellite view of the 425 m² plot for lease in Desa Ped, Nusa Penida, on the coast road in front of the beach">
    </figure>

    <div class="lla-body">
      <span class="lla-badge"><i class="fa-solid fa-seedling" aria-hidden="true"></i> {{ t.badge }}</span>
      <h2 class="lla-title" id="lla-title">{{ t.title }}</h2>
      <p class="lla-lead" id="lla-lead">{{ t.lead }}</p>

      <ul class="lla-facts">
        {%- for fact in t.facts %}
        <li><i class="fa-solid fa-check" aria-hidden="true"></i> {{ fact }}</li>
        {%- endfor %}
      </ul>

      <p class="lla-direct"><i class="fa-solid fa-user-check" aria-hidden="true"></i> {{ t.directNote }}</p>

      <div class="lla-actions">
        <a class="lla-btn lla-btn-wa" target="_blank" rel="noopener"
           href="https://wa.me/{{ landAd.whatsapp }}?text={{ t.waText | urlencode | safe }}">
          <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
          {{ t.cta }} · {{ landAd.whatsappDisplay }}
        </a>
        <a class="lla-btn lla-btn-ghost" href="{{ detailsUrl }}">{{ t.details }} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </div>
</div>

<style>
  .lla-overlay{position:fixed;inset:0;z-index:2000;display:flex;align-items:center;justify-content:center;padding:20px;background:rgba(4,41,62,.62);backdrop-filter:blur(4px);opacity:0;transition:opacity .28s ease}
  .lla-overlay[hidden]{display:none}
  .lla-overlay.is-open{opacity:1}
  .lla-card{outline:none;position:relative;display:grid;grid-template-columns:minmax(0,0.85fr) minmax(0,1.15fr);width:min(920px,100%);max-height:min(88vh,780px);background:#fff;border-radius:var(--radius,18px);overflow:hidden;box-shadow:0 30px 80px rgba(4,41,62,.35);transform:translateY(18px) scale(.98);transition:transform .28s ease}
  .lla-overlay.is-open .lla-card{transform:none}

  .lla-close{position:absolute;top:12px;right:12px;z-index:2;width:40px;height:40px;border:none;border-radius:50%;background:rgba(255,255,255,.92);color:var(--text-dark,#1f2a30);font-size:1.15rem;line-height:1;cursor:pointer;box-shadow:0 4px 14px rgba(4,41,62,.18);transition:background .2s ease,transform .2s ease}
  .lla-close:hover{background:#fff;transform:rotate(90deg)}
  .lla-close:focus-visible{outline:2px solid var(--secondary-color,#ff6b4a);outline-offset:2px}

  .lla-media{margin:0;background:var(--sand-2,#f3ece0)}
  .lla-media img{display:block;width:100%;height:100%;object-fit:cover;object-position:center 32%}

  .lla-body{min-width:0;padding:32px 34px;overflow-y:auto;-webkit-overflow-scrolling:touch}
  .lla-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(19,181,166,.12);color:#0e8378;font-family:var(--font-heading,sans-serif);font-weight:700;font-size:.72rem;letter-spacing:.6px;text-transform:uppercase;padding:6px 13px;border-radius:20px}
  .lla-title{font-size:1.55rem;line-height:1.25;color:var(--primary-color,#00557f);margin:14px 0 10px}
  .lla-lead{font-size:.98rem;color:#54626a;margin-bottom:18px}

  .lla-facts{list-style:none;margin:0 0 18px;padding:0;display:grid;gap:9px}
  .lla-facts li{display:flex;align-items:flex-start;gap:10px;font-size:.93rem;color:var(--text-dark,#1f2a30)}
  .lla-facts li i{color:var(--aqua,#13b5a6);margin-top:5px;font-size:.8rem;flex-shrink:0}

  .lla-direct{display:flex;align-items:flex-start;gap:10px;background:var(--bg-light,#fbf8f3);border-left:3px solid var(--secondary-color,#ff6b4a);border-radius:0 8px 8px 0;padding:11px 14px;font-size:.9rem;color:#54626a;margin-bottom:22px}
  .lla-direct i{color:var(--secondary-color,#ff6b4a);margin-top:4px;flex-shrink:0}

  .lla-actions{display:flex;flex-direction:column;gap:11px}
  .lla-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;text-align:center;overflow-wrap:anywhere;text-decoration:none;font-family:var(--font-heading,sans-serif);font-weight:700;font-size:.97rem;padding:14px 20px;border-radius:30px;transition:transform .2s ease,background .2s ease,color .2s ease}
  .lla-btn:hover{transform:translateY(-2px)}
  .lla-btn:focus-visible{outline:2px solid var(--primary-color,#00557f);outline-offset:2px}
  .lla-btn-wa{background:#25d366;color:#fff;box-shadow:0 8px 22px rgba(37,211,102,.28)}
  .lla-btn-wa:hover{background:#1da851}
  .lla-btn-ghost{background:transparent;color:var(--primary-color,#00557f);border:2px solid rgba(0,85,127,.22);padding:12px 20px}
  .lla-btn-ghost:hover{border-color:var(--primary-color,#00557f)}

  @media(max-width:820px){
    .lla-card{grid-template-columns:minmax(0,1fr);grid-template-rows:auto minmax(0,1fr);max-height:92vh}
    .lla-media{height:170px}
    .lla-media img{object-position:center 30%}
    .lla-body{padding:24px 22px 26px}
    .lla-title{font-size:1.3rem}
    .lla-facts li{font-size:.89rem}
    .lla-btn{font-size:.92rem;padding:13px 16px}
    .lla-btn-ghost{padding:11px 16px}
  }
  @media(prefers-reduced-motion:reduce){
    .lla-overlay,.lla-card,.lla-btn,.lla-close{transition:none}
    .lla-card{transform:none}
  }
</style>

<script>
(function () {
  var overlay = document.getElementById('lla-overlay');
  if (!overlay) return;

  // Snooze a dismissal for a week so returning visitors are not nagged.
  // Bump the key when the advert changes to show it to everyone again.
  var KEY = 'brv_land_ad_v1';
  var SNOOZE_MS = 7 * 24 * 60 * 60 * 1000;
  var store = null;
  try { store = window.localStorage; } catch (e) { /* private mode — just show it */ }

  function snoozed() {
    if (!store) return false;
    var until = parseInt(store.getItem(KEY) || '0', 10);
    return until > Date.now();
  }

  var lastFocused = null;

  function open() {
    lastFocused = document.activeElement;
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(function () { overlay.classList.add('is-open'); });
    // Focus the dialog itself rather than the close button: keyboard users still
    // land inside it, but a visitor who never touched the keyboard sees no focus ring.
    var card = document.getElementById('lla-card');
    if (card) card.focus();
    document.addEventListener('keydown', onKeydown);
  }

  function close() {
    if (store) { try { store.setItem(KEY, String(Date.now() + SNOOZE_MS)); } catch (e) {} }
    overlay.classList.remove('is-open');
    document.body.style.overflow = '';
    document.removeEventListener('keydown', onKeydown);
    window.setTimeout(function () { overlay.hidden = true; }, 280);
    if (lastFocused && lastFocused.focus) lastFocused.focus();
  }

  function onKeydown(e) {
    if (e.key === 'Escape' || e.key === 'Esc') close();
  }

  document.getElementById('lla-close').addEventListener('click', close);
  // Click on the backdrop (not the card) dismisses too.
  overlay.addEventListener('click', function (e) { if (e.target === overlay) close(); });
  // Following either link counts as engagement — stop showing the pop-up.
  overlay.querySelectorAll('.lla-btn').forEach(function (btn) { btn.addEventListener('click', close); });

  if (!snoozed()) window.setTimeout(open, 1400);
})();
</script>
{% endif %}
