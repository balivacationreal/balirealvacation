};

// ---------- helpers ----------
const $ = (id) => document.getElementById(id);
const esc = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, (c) =>
  ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[c]));
const todayISO = () => { const d=new Date(); return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0"); };

function money(n, cur) {
  const v = Number(n) || 0;
  if (cur === "IDR") return "Rp " + new Intl.NumberFormat("id-ID",{maximumFractionDigits:0}).format(Math.round(v));
  const sym = cur === "AUD" ? "A$" : "$";
  return sym + new Intl.NumberFormat("en-US",{minimumFractionDigits:2,maximumFractionDigits:2}).format(v);
}
function longDate(iso, lang) {
  if (!iso) return "—";
  const d = new Date(iso + "T00:00:00");
  if (isNaN(d)) return iso;
  const loc = lang === "id" ? "id-ID" : lang === "zh" ? "zh-CN" : "en-GB";
  return d.toLocaleDateString(loc, { day:"numeric", month:"long", year:"numeric" });
}
function nextDocNo() {
  const day = todayISO().replace(/-/g,"");
  const key = "brv_docno_" + day;
  const n = (parseInt(localStorage.getItem(key) || "0", 10) || 0) + 1;
  try { localStorage.setItem(key, String(n)); } catch (e) {}
  return "BRV-" + day + "-" + String(n).padStart(3,"0");
}
// ---------- link payload ----------
// The whole booking rides in the URL, so it is deflated before base64. Booking
// JSON is repetitive text and compresses to roughly a third. The result is
// tagged so both shapes stay readable forever:
//   #z=…  deflated  (what every current browser produces)
//   #d=…  plain     (fallback, and every link issued before compression landed)
function b64url(bytes) {
  let bin = ""; bytes.forEach((b) => { bin += String.fromCharCode(b); });
  return btoa(bin).replace(/\+/g,"-").replace(/\//g,"_").replace(/=+$/,"");
}
function unb64url(s) {
  const b64 = s.replace(/-/g,"+").replace(/_/g,"/");
  const bin = atob(b64 + "=".repeat((4 - (b64.length % 4)) % 4));
  return Uint8Array.from(bin, (c) => c.charCodeAt(0));
}
async function through(bytes, Ctor) {
  const s = new Ctor("deflate-raw");
  const writer = s.writable.getWriter();
  writer.write(bytes); writer.close();
  const chunks = []; let len = 0;
  const reader = s.readable.getReader();
  for (;;) {
    const { done, value } = await reader.read();
    if (done) break;
    chunks.push(value); len += value.length;
  }
  const out = new Uint8Array(len); let at = 0;
  chunks.forEach((c) => { out.set(c, at); at += c.length; });
  return out;
}
async function encodeState(o) {
  const bytes = new TextEncoder().encode(JSON.stringify(o));
  if (window.CompressionStream) {
    try {
      const z = await through(bytes, window.CompressionStream);
      if (z.length < bytes.length) return "z=" + b64url(z);
    } catch (e) { /* fall through to the plain form */ }
  }
  return "d=" + b64url(bytes);
}
async function decodeState(kind, payload) {
  let bytes = unb64url(payload);
  if (kind === "z") bytes = await through(bytes, window.DecompressionStream);
  return JSON.parse(new TextDecoder().decode(bytes));
}

// ---------- state ----------
function blankState() {
  return {
    v: 1, type: "receipt", lang: "en", cur: "IDR", rid: "",
    no: nextDocNo(), issued: todayISO(),
    guest: { name:"", wa:"", email:"", country:"", pax:2 },
    svc: { title:"", date:"", time:"", pickup:"", dropoff:"", flight:"", vehicle:"", driver:"Ketut", driverWa:"+62 823-1779-4462" },
    itin: [],
    incl: "",
    items: [{ desc:"", qty:1, price:0 }],
    pay: { status:"paid", method:"cash_driver", paid:0, receivedBy:"Ketut (driver)", cashIdr:"", date:"" },
    notes: T.en.defaultNotes,
  };
}
let S = blankState();

// The notes block is boilerplate until the operator edits it. Comparing against
// every language's default lets a language switch keep swapping it, while a note
// the operator actually wrote is never overwritten.
function notesAreBoilerplate() {
  return !S.notes || Object.keys(T).some((k) => T[k].defaultNotes === S.notes);
}

// ---------- editor -> state ----------
const FIELD_MAP = {
  "f-type":["type"], "f-lang":["lang"], "f-no":["no"], "f-issued":["issued"], "f-cur":["cur"],
  "f-guest-name":["guest","name"], "f-guest-wa":["guest","wa"], "f-guest-email":["guest","email"],
  "f-guest-country":["guest","country"], "f-guest-pax":["guest","pax"],
  "f-svc-title":["svc","title"], "f-svc-date":["svc","date"], "f-svc-time":["svc","time"],
  "f-svc-pickup":["svc","pickup"], "f-svc-dropoff":["svc","dropoff"], "f-svc-flight":["svc","flight"],
  "f-svc-vehicle":["svc","vehicle"], "f-svc-driver":["svc","driver"], "f-svc-driver-wa":["svc","driverWa"],
  "f-incl":["incl"],
  "f-pay-status":["pay","status"], "f-pay-method":["pay","method"],
  "f-pay-paid":["pay","paid"], "f-pay-received-by":["pay","receivedBy"], "f-pay-date":["pay","date"],
  "f-pay-cash-idr":["pay","cashIdr"],
  "f-notes":["notes"],
};
function readFields() {
  Object.entries(FIELD_MAP).forEach(([id, path]) => {
    const el = $(id); if (!el) return;
    let val = el.value;
    if (el.type === "number") val = val === "" ? "" : Number(val);
    if (path.length === 1) S[path[0]] = val; else S[path[0]][path[1]] = val;
  });
  S.itin = [...document.querySelectorAll("#itin-rows .repeat-row")].map((r) => ({
    time: r.querySelector(".i-time").value,
    act:  r.querySelector(".i-act").value,
    note: r.querySelector(".i-note").value,
  })).filter((r) => r.time || r.act || r.note);
  S.items = [...document.querySelectorAll("#item-rows .repeat-row")].map((r) => ({
    desc:  r.querySelector(".it-desc").value,
    qty:   Number(r.querySelector(".it-qty").value) || 0,
    price: Number(r.querySelector(".it-price").value) || 0,
  }));
}
function writeFields() {
  Object.entries(FIELD_MAP).forEach(([id, path]) => {
    const el = $(id); if (!el) return;
    el.value = path.length === 1 ? (S[path[0]] ?? "") : (S[path[0]][path[1]] ?? "");
  });
  $("itin-rows").innerHTML = "";
  (S.itin.length ? S.itin : []).forEach(addItinRow);
  $("item-rows").innerHTML = "";
  (S.items.length ? S.items : [{ desc:"", qty:1, price:0 }]).forEach(addItemRow);
}

function addItinRow(v) {
  v = v || { time:"", act:"", note:"" };
  const d = document.createElement("div");
  d.className = "repeat-row";
  d.innerHTML =
    '<input class="i-time t" type="text" placeholder="08:00" value="' + esc(v.time) + '">' +
    '<div class="grow" style="display:flex;flex-direction:column;gap:6px">' +
      '<input class="i-act" type="text" placeholder="Stop / activity" value="' + esc(v.act) + '">' +
      '<input class="i-note" type="text" placeholder="Note (optional)" value="' + esc(v.note) + '">' +
    "</div>" +
    '<button type="button" class="mini-btn danger" title="Remove"><i class="fa-solid fa-trash"></i></button>';
  d.querySelector("button").addEventListener("click", () => { d.remove(); sync(); });
  $("itin-rows").appendChild(d);
}
function addItemRow(v) {
  v = v || { desc:"", qty:1, price:0 };
  const d = document.createElement("div");
  d.className = "repeat-row";
  d.innerHTML =
    '<input class="it-desc grow" type="text" placeholder="Description" value="' + esc(v.desc) + '">' +
    '<input class="it-qty num" type="number" min="0" step="any" placeholder="Qty" value="' + esc(v.qty) + '">' +
    '<input class="it-price amt" type="number" min="0" step="any" placeholder="Price" value="' + esc(v.price) + '">' +
    '<button type="button" class="mini-btn danger" title="Remove"><i class="fa-solid fa-trash"></i></button>';
  d.querySelector("button").addEventListener("click", () => { d.remove(); sync(); });
  $("item-rows").appendChild(d);
}

// ---------- render the document ----------
function render() {
  const t = T[S.lang] || T.en;
  const cur = S.cur;
  const total = S.items.reduce((s, i) => s + (Number(i.qty)||0) * (Number(i.price)||0), 0);
  const paid = S.pay.status === "paid" ? total : (Number(S.pay.paid) || 0);
  const balance = Math.max(0, total - paid);

  document.documentElement.lang = S.lang;
  $("d-title").textContent = t[S.type] || t.receipt;
  $("d-no-label").textContent = t.no;
  $("d-date-label").textContent = t.date;
  $("d-no").textContent = S.no || "—";
  $("d-date").textContent = longDate(S.issued, S.lang);
  $("d-co-tagline").textContent = t.tagline;
  $("d-billed-label").textContent = t.billed;
  $("d-service-label").textContent = t.service;
  $("d-itin-label").textContent = t.itinerary;
  $("d-incl-label").textContent = t.included;
  $("d-charges-label").textContent = t.charges;
  $("d-th-desc").textContent = t.desc;
  $("d-th-qty").textContent = t.qty;
  $("d-th-price").textContent = t.price;
  $("d-th-amount").textContent = t.amount;
  $("d-subtotal-label").textContent = t.subtotal;
  $("d-total-label").textContent = t.total;
  $("d-paid-label").textContent = t.received;
  $("d-balance-label").textContent = t.balance;
  $("d-pay-label").textContent = t.payment;
  $("d-foot-thanks").textContent = t.thanks;
  $("d-foot-issued").textContent = t.issued;
  $("guest-bar-text").textContent = t.guestBar;
  $("guest-bar-btn").textContent = t.download;

  // status pill + stamp
  const pill = $("d-pill"), stamp = $("d-stamp");
  pill.className = "pill " + S.pay.status;
  pill.textContent = t[S.pay.status];
  stamp.className = "stamp " + S.pay.status;
  stamp.textContent = t[S.pay.status];

  // Each line is its own block, so an empty optional field leaves no gap and a
  // long label (like "Driver WhatsApp") never collides with its value.
  const line = (k, v) => '<span class="r"><span class="k">' + k + '</span><span class="v">' + v + "</span></span>";

  // guest block
  const g = S.guest, rows = [];
  rows.push('<span class="guest-name">' + esc(g.name || "—") + "</span>");
  if (g.wa)      rows.push(line(t.phone,   esc(g.wa)));
  if (g.email)   rows.push(line(t.email,   esc(g.email)));
  if (g.country) rows.push(line(t.country, esc(g.country)));
  if (g.pax)     rows.push(line(t.guests,  esc(g.pax) + " " + t.pax));
  $("d-guest").innerHTML = rows.join("");

  // service block
  const s = S.svc, sr = [];
  if (s.title)    sr.push('<span class="guest-name">' + esc(s.title) + "</span>");
  if (s.date)     sr.push(line(t.sdate,    longDate(s.date, S.lang)));
  if (s.time)     sr.push(line(t.stime,    esc(s.time)));
  if (s.flight)   sr.push(line(t.flight,   esc(s.flight)));
  if (s.pickup)   sr.push(line(t.pickup,   esc(s.pickup)));
  if (s.dropoff)  sr.push(line(t.dropoff,  esc(s.dropoff)));
  if (s.vehicle)  sr.push(line(t.vehicle,  esc(s.vehicle)));
  if (s.driver)   sr.push(line(t.driver,   esc(s.driver)));
  if (s.driverWa) sr.push(line(t.driverWa, esc(s.driverWa)));
  $("d-service").innerHTML = sr.join("") || "—";

  // itinerary
  const itin = S.itin.filter((r) => r.time || r.act || r.note);
  $("d-itin-wrap").style.display = itin.length ? "" : "none";
  $("d-itin").innerHTML = itin.map((r) =>
    '<tr><td class="time-col">' + esc(r.time || "") + "</td><td>" + esc(r.act || "") +
    (r.note ? '<span class="note">' + esc(r.note) + "</span>" : "") + "</td></tr>").join("");

  // inclusions
  const incl = (S.incl || "").split("\n").map((l) => l.trim()).filter(Boolean);
  $("d-incl-wrap").style.display = incl.length ? "" : "none";
  $("d-incl").innerHTML = incl.map((l) =>
    '<span style="display:block">✓ &nbsp;' + esc(l) + "</span>").join("");

  // charges
  $("d-items").innerHTML = S.items.filter((i) => i.desc || i.price).map((i) =>
    "<tr><td>" + esc(i.desc || "—") + '</td><td class="r">' + (Number(i.qty)||0) +
    '</td><td class="r">' + money(i.price, cur) + '</td><td class="r">' +
    money((Number(i.qty)||0) * (Number(i.price)||0), cur) + "</td></tr>").join("")
    || '<tr><td colspan="4" style="color:#999">—</td></tr>';

  $("d-subtotal").textContent = money(total, cur);
  $("d-total").textContent = money(total, cur);
  $("d-paid").textContent = money(paid, cur);
  $("d-balance").textContent = money(balance, cur);
  $("d-paid-row").style.display = paid > 0 ? "" : "none";
  $("d-balance-row").style.display = balance > 0 ? "" : "none";

  // Payment box. Nothing has been handed over yet on an unpaid document, so it
  // reads forwards ("to be paid to") rather than backwards ("received by").
  const settled = paid > 0;
  const p = [];
  p.push(line(t.status, t[S.pay.status]));
  p.push(line(t.method, (settled ? t.m : t.mDue)[S.pay.method] || "—"));
  if (settled) p.push(line(t.received, money(paid, cur)));
  if (S.pay.receivedBy) p.push(line(settled ? t.receivedBy : t.payTo, esc(S.pay.receivedBy)));
  // Cash is handed over on the day of travel, which is rarely the day the
  // document was issued — so this follows the payment date, never the issue date.
  if (settled) p.push(line(t.paidOn, longDate(S.pay.date || S.issued, S.lang)));
  if (balance > 0) {
    p.push(line(t.dueWhen, S.svc.date
      ? longDate(S.svc.date, S.lang) + " — " + t.dueOnDay
      : t.dueOnDay));
  }
  // A guest paying cash in Bali needs the rupiah figure, whatever currency we quoted in.
  if (balance > 0 && Number(S.pay.cashIdr) > 0) {
    p.push(line(t.cashIdr, money(S.pay.cashIdr, "IDR") + ' <span style="font-weight:400;color:var(--muted)">— ' + t.cashIdrNote + "</span>"));
  }
  $("d-pay").innerHTML = p.join("");

  $("d-notes").textContent = S.notes || "";
  checkMissing(total, paid, balance);
}

// Empty fields are simply left off the document, which keeps it tidy but also
// means an omission is invisible. This flags the ones a guest or driver would
// actually miss. Screen-only — it never prints and never blocks anything.
function checkMissing(total, paid, balance) {
  const miss = [];
  if (!S.guest.name) miss.push("Guest name");
  if (!S.svc.title) miss.push("Service name — the document says what was charged but not what was booked");
  if (!S.svc.date) miss.push("Service date — the guest and driver need to know which day this is for");
  if (!S.svc.time) miss.push("Pickup time");
  if (!S.svc.pickup) miss.push("Pickup point");
  if (!total) miss.push("A line item with a price");
  if (!S.guest.wa) miss.push("Guest WhatsApp number — needed for the Send on WhatsApp button");
  if (paid > 0 && !S.pay.date && S.svc.date && S.svc.date !== S.issued) {
    miss.push("Payment date — without it the document says the money changed hands on " +
              "the issue date, not on the day of travel");
  }
  if (balance > 0 && S.cur !== "IDR" && !(Number(S.pay.cashIdr) > 0)) {
    miss.push("Cash amount in IDR — this guest pays cash in Bali but the total is in " + S.cur);
  }
  const el = $("warn");
  if (!miss.length) { el.hidden = true; return; }
  el.hidden = false;
  el.innerHTML = "<b>Worth adding before you send this</b><ul>" +
    miss.map((m) => "<li>" + esc(m) + "</li>").join("") + "</ul>";
}

function sync() { readFields(); render(); saveDraft(); refreshLink(); }

// ---------- persistence ----------
const DRAFT_KEY = "brv_receipt_draft";
const LIST_KEY  = "brv_receipts";
function saveDraft() { try { localStorage.setItem(DRAFT_KEY, JSON.stringify(S)); } catch (e) {} }
function loadList()  { try { return JSON.parse(localStorage.getItem(LIST_KEY) || "[]"); } catch (e) { return []; } }
function writeList(l){ try { localStorage.setItem(LIST_KEY, JSON.stringify(l)); } catch (e) {} }
function flash(msg)  { const el = $("status-msg"); el.textContent = msg; clearTimeout(flash._t); flash._t = setTimeout(() => { el.textContent = ""; }, 3500); }

function saveBooking() {
  readFields();
  if (!S.guest.name) { flash("Add a guest name before saving."); return; }
  const list = loadList();
  const i = list.findIndex((b) => (S.rid && b.rid === S.rid) || b.no === S.no);
  const entry = { no: S.no, name: S.guest.name, svc: S.svc.title, date: S.svc.date || S.issued,
                  saved: Date.now(), rid: S.rid || undefined, data: S };
  if (i >= 0) list[i] = entry; else list.unshift(entry);
  writeList(list.slice(0, 60));
  renderList();
  flash("Saved " + S.no + " to this device.");
}
function renderList() {
  const list = loadList(), ul = $("saved-list");
  if (!list.length) { ul.innerHTML = '<li class="saved-empty">No saved bookings yet.</li>'; return; }
  ul.innerHTML = "";
  list.forEach((b, idx) => {
    const li = document.createElement("li");
    li.innerHTML =
      '<span class="s-main"><span class="s-name">' + esc(b.name) + '</span>' +
      '<span class="s-meta">' + esc(b.no) + (b.svc ? " · " + esc(b.svc) : "") +
      (b.remote ? ' <i class="fa-solid fa-cloud" title="issued on another device"></i>' : "") + "</span></span>" +
      '<button class="mini-btn" data-a="load" title="Open">Open</button>' +
      '<button class="mini-btn danger" data-a="del" title="Delete"><i class="fa-solid fa-trash"></i></button>';
    li.querySelector('[data-a="load"]').addEventListener("click", () => {
      if (b.remote || !b.data) { openRemote(b.rid); return; }
      S = b.data; writeFields(); render(); saveDraft(); refreshLink();
      flash("Loaded " + b.no + ".");
    });
    li.querySelector('[data-a="del"]').addEventListener("click", () => {
      const l = loadList(); l.splice(idx, 1); writeList(l); renderList();
    });
    ul.appendChild(li);
  });
}

// Bookings issued from any device, straight out of Convex. The local list is
// still the fast path; this is for "I made it on the laptop, I am on my phone".
async function syncFromServer() {
  flash("Fetching…");
  try {
    const rows = await convexCall("query", "receipts:recent", {
      limit: 40, key: issuerKey() || undefined,
    });
    if (!rows || !rows.length) { flash("Nothing issued from any device yet."); return; }
    const list = loadList();
    let added = 0;
    rows.forEach((r) => {
      if (list.some((b) => b.rid === r.rid)) return;
      list.push({
        no: r.no || r.rid, name: r.guest || "(no name)", svc: "",
        date: "", saved: r.updatedAt, rid: r.rid, remote: true,
      });
      added++;
    });
    list.sort((a, b) => (b.saved || 0) - (a.saved || 0));
    writeList(list.slice(0, 80));
    renderList();
    flash(added ? "Added " + added + " booking(s) from other devices." : "Already up to date.");
  } catch (e) {
    flash("Could not reach the server.");
  }
}

// Remote entries hold only a summary, so opening one fetches the document.
async function openRemote(rid) {
  flash("Opening…");
  try {
    const rec = await convexCall("query", "receipts:get", { rid });
    if (!rec) { flash("That booking is no longer on the server."); return; }
    S = unpackState(JSON.parse(rec.data));
    S.rid = rid;
    writeFields(); render(); saveDraft(); refreshLink();
    flash("Opened " + (S.no || rid) + ".");
  } catch (e) {
    flash("Could not open that booking.");
  }
}

// ---------- sharing ----------
// The link carries the entire booking, so strip anything the other side can
// rebuild by itself: empty fields, and boilerplate notes the operator left alone.
function prune(o) {
  const out = {};
  Object.keys(o).forEach((k) => {
    const v = o[k];
    if (v === "" || v === null || v === undefined) return;
    if (Array.isArray(v)) { if (v.length) out[k] = v; return; }
    if (typeof v === "object") { out[k] = prune(v); return; }
    out[k] = v;
  });
  return out;
}
function packState() {
  const c = JSON.parse(JSON.stringify(S));
  if (notesAreBoilerplate()) delete c.notes;
  return prune(c);
}
function unpackState(o) {
  const s = blankState();
  const nested = ["guest", "svc", "pay"];
  Object.keys(o).forEach((k) => { if (nested.indexOf(k) < 0) s[k] = o[k]; });
  nested.forEach((k) => { if (o[k]) Object.assign(s[k], o[k]); });
  if (!o.itin) s.itin = [];
  if (o.notes === undefined) s.notes = (T[s.lang] || T.en).defaultNotes;
  return s;
}
// ---------- short links, stored in Convex ----------
// The booking is kept server-side against a short id, so a guest link is a
// dozen characters rather than a kilobyte of encoded booking. If Convex cannot
// be reached the page falls back to the self-contained #z= link, which still
// works with no backend at all.
const CONVEX_URL = (typeof window !== "undefined" && window.CONVEX_URL) ||
  "https://colorless-gnu-950.convex.cloud";
const KEY_STORE = "brv_receipt_key";
function issuerKey() { try { return localStorage.getItem(KEY_STORE) || ""; } catch (e) { return ""; } }

async function convexCall(kind, path, args) {
  const res = await fetch(CONVEX_URL + "/api/" + kind, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ path, args, format: "json" }),
  });
  if (!res.ok) throw new Error("Convex HTTP " + res.status);
  const out = await res.json();
  if (out.status !== "success") throw new Error(out.errorMessage || "Convex rejected the call");
  return out.value;
}

// Publishing is debounced and only fires once the document is a real booking,
// so half-typed drafts never reach the database. Re-publishing reuses the same
// rid, so a booking keeps one stable link however often it is edited.
let publishTimer = null;
function schedulePublish() {
  clearTimeout(publishTimer);
  publishTimer = setTimeout(publishNow, 1200);
}
function looksReal() {
  const total = S.items.reduce((t, i) => t + (Number(i.qty) || 0) * (Number(i.price) || 0), 0);
  return Boolean(S.guest.name) && total > 0;
}
async function publishNow() {
  if (!looksReal()) return;
  const seq = linkSeq;
  try {
    const out = await convexCall("mutation", "receipts:save", {
      rid: S.rid || undefined,
      data: JSON.stringify(packState()),
      no: S.no || undefined,
      guest: S.guest.name || undefined,
      key: issuerKey() || undefined,
    });
    if (out && out.rid && seq === linkSeq) {
      S.rid = out.rid;
      linkCache = location.origin + location.pathname + "?r=" + out.rid;
      saveDraft();
    }
  } catch (e) {
    // Long link stays in place; nothing to tell the operator.
    console.warn("Short link unavailable, using the self-contained link.", e);
  }
}

async function guestLink() {
  readFields();
  return location.origin + location.pathname + "#" + (await encodeState(packState()));
}

// Compressing is asynchronous, but a browser only allows a clipboard write or a
// popup while the click that triggered it is still "live". So the link is
// rebuilt in the background after every edit and the buttons use that cache,
// keeping them synchronous. The sequence guard stops a slow earlier build from
// overwriting a newer one.
let linkCache = "", linkSeq = 0;
function refreshLink() {
  const seq = ++linkSeq;
  linkCache = "";
  schedulePublish();   // a short link for this edit follows once typing settles
  encodeState(packState())
    .then((p) => { if (seq === linkSeq) linkCache = location.origin + location.pathname + "#" + p; })
    .catch(() => {});
}
async function copyLink() {
  const url = linkCache || (await guestLink());
  try {
    await navigator.clipboard.writeText(url);
    flash("Guest link copied — paste it into WhatsApp.");
  } catch (e) {
    window.prompt("Copy this link and send it to your guest:", url);
  }
}
function sendWhatsApp() {
  readFields();
  const t = T[S.lang] || T.en;
  const digits = (S.guest.wa || "").replace(/[^\d]/g, "");
  const docName = (t[S.type] || t.receipt).toLowerCase();
  const base = digits ? "https://wa.me/" + digits : "https://wa.me/";
  const chatUrl = (link) =>
    base + "?text=" + encodeURIComponent(t.waMsg(S.guest.name || "", docName) + "\n" + link);

  if (linkCache) { window.open(chatUrl(linkCache), "_blank"); return; }
  // Cache not ready: claim the tab now, while the click still counts, and point
  // it at WhatsApp once the link finishes building.
  const win = window.open("", "_blank");
  guestLink().then((link) => {
    if (win) win.location = chatUrl(link);
    else window.open(chatUrl(link), "_blank");
  });
}

// ---------- quick-fill presets ----------
function buildPresets() {
  const sel = $("f-preset");
  const gt = document.createElement("optgroup"); gt.label = "Airport transfer (per car, IDR)";
  TRANSFERS.forEach(([name, idr]) => {
    const o = document.createElement("option");
    o.value = "t|" + name + "|" + idr;
    o.textContent = "DPS → " + name + " — Rp " + new Intl.NumberFormat("id-ID").format(idr);
    gt.appendChild(o);
  });
  sel.appendChild(gt);
  const gr = document.createElement("optgroup"); gr.label = "Tours (per person, USD)";
  TOURS.forEach(([name, p2, p3, p4]) => {
    const o = document.createElement("option");
    o.value = "u|" + name + "|" + p2 + "|" + p3 + "|" + p4;
    o.textContent = name + " — from $" + p4 + " pp";
    gr.appendChild(o);
  });
  sel.appendChild(gr);
  const gd = document.createElement("optgroup"); gd.label = "Private driver";
  const o = document.createElement("option");
  o.value = "d|Private Driver Tour (full day)|" + DRIVER_DAY_RATE;
  o.textContent = "Full-day private driver — Rp " + new Intl.NumberFormat("id-ID").format(DRIVER_DAY_RATE);
  gd.appendChild(o); sel.appendChild(gd);

  sel.addEventListener("change", () => {
    if (!sel.value) return;
    const parts = sel.value.split("|");
    const kind = parts[0], name = parts[1];
    readFields();
    const pax = Number(S.guest.pax) || 2;

    if (kind === "t") {
      S.cur = "IDR";
      S.svc.title = "Airport Transfer — DPS to " + name;
      S.svc.pickup = S.svc.pickup || "Ngurah Rai International Airport (DPS), Arrivals Hall";
      S.svc.dropoff = S.svc.dropoff || name;
      S.items = [{ desc: "Private airport transfer, DPS → " + name + " (up to 4 passengers)", qty: 1, price: Number(parts[2]) }];
      if (!S.incl) S.incl = "Private air-conditioned car\nEnglish-speaking driver\nFlight monitoring & name-sign meet\nComplimentary cold drinks and bottled water";
      if (!S.itin.length) S.itin = [
        { time: "", act: "Driver waits in the arrivals hall with your name sign", note: "Your driver tracks your flight — no charge for delays" },
        { time: "", act: "Direct private transfer to " + name, note: "" },
      ];
    } else if (kind === "u") {
      S.cur = "USD";
      const pp = pax >= 4 ? Number(parts[4]) : pax === 3 ? Number(parts[3]) : Number(parts[2]);
      S.svc.title = name;
      S.items = [{ desc: name + " — all-inclusive private tour (per person)", qty: pax, price: pp }];
      if (!S.incl) S.incl = "Private air-conditioned transport\nEnglish-speaking driver-guide\nAll entrance fees\nLunch";
    } else {
      S.cur = "IDR";
      S.svc.title = name;
      S.items = [{ desc: name + " — private car, fuel and English-speaking driver (per day)", qty: 1, price: Number(parts[2]) }];
      if (!S.incl) S.incl = "Private air-conditioned car\nFuel\nEnglish-speaking driver-guide for the full day";
    }
    if (S.pay.status === "paid") S.pay.paid = S.items.reduce((s, i) => s + i.qty * i.price, 0);
    writeFields(); render(); saveDraft();
    sel.value = "";
  });
}

// ---------- boot ----------
function applyLangDefaults() {
  const t = T[S.lang] || T.en;
  if (notesAreBoilerplate()) { S.notes = t.defaultNotes; $("f-notes").value = S.notes; }
}

function initEditor() {
  buildPresets();
  Object.keys(FIELD_MAP).forEach((id) => {
    const el = $(id); if (!el) return;
    el.addEventListener("input", () => {
      if (id === "f-lang") { readFields(); applyLangDefaults(); }
      // Marking a booking paid almost always means "paid on the day of travel",
      // so seed the date from the service date instead of silently using today.
      if (id === "f-pay-status") {
        readFields();
        if (S.pay.status !== "unpaid" && !S.pay.date) {
          S.pay.date = S.svc.date || S.issued;
          $("f-pay-date").value = S.pay.date;
        }
      }
      sync();
    });
    el.addEventListener("change", sync);
  });
  $("itin-rows").addEventListener("input", sync);
  $("item-rows").addEventListener("input", sync);
  $("btn-add-itin").addEventListener("click", () => { addItinRow(); sync(); });
  $("btn-add-item").addEventListener("click", () => { addItemRow(); sync(); });
  $("btn-print").addEventListener("click", () => { readFields(); render(); window.print(); });
  $("btn-copy").addEventListener("click", copyLink);
  $("btn-wa").addEventListener("click", sendWhatsApp);
  $("btn-save").addEventListener("click", () => { saveBooking(); publishNow(); });
  $("btn-sync").addEventListener("click", syncFromServer);
  const keyField = $("f-key");
  keyField.value = issuerKey();
  keyField.addEventListener("change", () => {
    try { localStorage.setItem(KEY_STORE, keyField.value.trim()); } catch (e) {}
    flash(keyField.value.trim() ? "Issuer key saved on this device." : "Issuer key cleared.");
  });
  $("btn-new").addEventListener("click", () => {
    if (!window.confirm("Start a new blank document? Unsaved changes are lost.")) return;
    S = blankState();
    history.replaceState(null, "", location.pathname);
    document.body.classList.remove("guest-view");
    writeFields(); render(); saveDraft();
  });
  renderList();
}

// A guest opening a dead or unreachable link needs to be told, not shown a
// blank receipt they might mistake for their booking.
function showLoadError(detail) {
  document.body.classList.add("guest-view");
  const doc = $("doc");
  doc.innerHTML =
    '<div style="padding:40px 10px;text-align:center">' +
    '<h2 style="color:var(--primary-color);font-size:1.2rem;margin-bottom:10px">' +
    "We could not open this booking</h2>" +
    '<p style="color:var(--muted);font-size:.9rem;line-height:1.7;max-width:440px;margin:0 auto">' +
    "The link may be incomplete, or the booking may have been removed. " +
    "Please message us on WhatsApp +62 823-1779-4462 and we will send it again." +
    '</p><p style="color:#b0b8bd;font-size:.72rem;margin-top:18px">' + esc(detail) + "</p></div>";
  $("guest-bar-text").textContent = "Booking not available";
  const btn = document.querySelector(".guest-bar .tb-btn");
  if (btn) btn.style.display = "none";
}

function startEditor() {
  try {
    const draft = JSON.parse(localStorage.getItem(DRAFT_KEY) || "null");
    if (draft && draft.v === 1) S = unpackState(draft);
  } catch (e) {}
  if (!S.issued) S.issued = todayISO();
  writeFields(); render(); initEditor(); refreshLink();
}

(async function boot() {
  // Short link: the booking lives in Convex under ?r=<id>.
  const rid = new URLSearchParams(location.search).get("r");
  if (rid) {
    try {
      const rec = await convexCall("query", "receipts:get", { rid });
      if (!rec) throw new Error("That receipt link is no longer available.");
      S = unpackState(JSON.parse(rec.data));
      S.rid = rid;
      document.body.classList.add("guest-view");
      writeFields(); render();
      return;
    } catch (e) {
      showLoadError(e && e.message ? e.message : String(e));
      return;
    }
  }
  // "z" is deflated, "d" is the plain form older links use — both still open.
  const m = (location.hash || "").match(/^#([dz])=(.+)$/);
  if (m) {
    try {
      S = unpackState(await decodeState(m[1], m[2]));
      document.body.classList.add("guest-view");
      writeFields(); render();
      // Read-only for the guest. To amend a booking, open /booking-receipt.html
      // with no link fragment and re-open it under "Saved bookings".
      return;
    } catch (e) {
      console.error("This receipt link looks damaged.", e);
    }
  }
  startEditor();
})();
</script>
</body>
