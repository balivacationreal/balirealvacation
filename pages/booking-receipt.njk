---
permalink: "/booking-receipt.html"
title: "Booking Receipt & Itinerary — Bali Real Vacation"
description: "Internal tool: generate a PDF booking receipt and day itinerary for a confirmed Bali Real Vacation booking."
canonical: "https://balirealvacation.com/booking-receipt.html"
robots: "noindex, nofollow"
eleventyExcludeFromCollections: true
---
{% raw %}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<title>Booking Receipt &amp; Itinerary — Bali Real Vacation</title>
<link rel="icon" type="image/webp" href="/src/assets/bali-real-vacation-logo.webp">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
:root{
  --primary-color:#00557f; --secondary-color:#ff6b4a; --aqua:#13b5a6;
  --ocean-deep:#04293e; --text-dark:#1f2a30; --bg-light:#fbf8f3; --sand-2:#f3ece0;
  --line:#e3e8ec; --muted:#6b7780;
  --font-heading:"Plus Jakarta Sans",sans-serif; --font-body:"Inter",sans-serif;
}
*{box-sizing:border-box}
body{margin:0;font-family:var(--font-body);color:var(--text-dark);background:#eef2f5;font-size:15px;line-height:1.55}
h1,h2,h3,h4{font-family:var(--font-heading);margin:0}
button{font:inherit;cursor:pointer}
input,select,textarea{font:inherit;color:inherit}

/* ---------- app shell ---------- */
.topbar{position:sticky;top:0;z-index:20;background:var(--ocean-deep);color:#fff;padding:10px 18px;display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.topbar .brand{display:flex;align-items:center;gap:10px;font-family:var(--font-heading);font-weight:800;letter-spacing:.2px;font-size:.95rem}
.topbar .brand img{width:30px;height:30px;object-fit:contain;background:#fff;border-radius:6px;padding:2px}
.topbar .spacer{flex:1}
.tb-btn{background:rgba(255,255,255,.12);color:#fff;border:1px solid rgba(255,255,255,.25);padding:8px 14px;border-radius:8px;font-weight:600;font-size:.85rem;display:inline-flex;align-items:center;gap:7px}
.tb-btn:hover{background:rgba(255,255,255,.22)}
.tb-btn.primary{background:var(--secondary-color);border-color:var(--secondary-color)}
.tb-btn.primary:hover{background:#ff8265}
.tb-btn.wa{background:#25D366;border-color:#25D366;color:#07341a}
.tb-btn.wa:hover{background:#3ade7a}

.layout{display:grid;grid-template-columns:minmax(340px,420px) 1fr;gap:24px;padding:24px;align-items:start;max-width:1500px;margin:0 auto}
@media (max-width:1080px){.layout{grid-template-columns:1fr}}

/* ---------- editor ---------- */
.editor{background:#fff;border-radius:14px;box-shadow:0 4px 18px rgba(4,41,62,.08);padding:20px;position:sticky;top:70px;max-height:calc(100vh - 94px);overflow-y:auto}
@media (max-width:1080px){.editor{position:static;max-height:none}}
.editor h2{font-size:1.05rem;color:var(--primary-color);margin-bottom:4px}
.editor .hint{font-size:.8rem;color:var(--muted);margin:0 0 16px}
fieldset{border:none;border-top:1px solid var(--line);padding:16px 0 4px;margin:0}
fieldset:first-of-type{border-top:none;padding-top:4px}
legend{font-family:var(--font-heading);font-weight:700;font-size:.78rem;letter-spacing:.09em;text-transform:uppercase;color:var(--aqua);padding:0}
.fg{margin-bottom:12px}
.fg label{display:block;font-size:.76rem;font-weight:600;color:var(--muted);margin-bottom:4px;letter-spacing:.02em}
.fg input,.fg select,.fg textarea{width:100%;padding:9px 11px;border:1px solid var(--line);border-radius:8px;background:#fff}
.fg input:focus,.fg select:focus,.fg textarea:focus{outline:2px solid rgba(19,181,166,.35);outline-offset:1px;border-color:var(--aqua)}
.fg textarea{resize:vertical;min-height:64px}
.row{display:flex;gap:10px}
.row>*{flex:1;min-width:0}
.mini-btn{background:var(--sand-2);border:1px solid var(--line);border-radius:8px;padding:7px 12px;font-size:.8rem;font-weight:600;color:var(--primary-color);display:inline-flex;align-items:center;gap:6px}
.mini-btn:hover{background:#e8dfcd}
.mini-btn.danger{color:#c62828;background:#fff;border-color:#f0d3d3;padding:7px 9px}
.mini-btn.danger:hover{background:#fdecea}
.repeat-row{display:flex;gap:8px;align-items:flex-start;margin-bottom:8px}
.repeat-row input{padding:8px 10px;border:1px solid var(--line);border-radius:8px;min-width:0;width:100%}
.repeat-row .t{flex:0 0 76px}
.repeat-row .grow{flex:1}
.repeat-row .num{flex:0 0 58px;text-align:right}
.repeat-row .amt{flex:0 0 100px;text-align:right}
.warn{margin:14px 0 0;padding:11px 13px;background:#fff8e6;border:1px solid #f2d99a;border-left:4px solid #e0a020;border-radius:8px;font-size:.79rem;line-height:1.6;color:#7a5300}
.warn b{display:block;margin-bottom:3px;font-family:var(--font-heading)}
.warn ul{margin:0;padding-left:18px}
.status-msg{font-size:.8rem;color:var(--aqua);font-weight:600;min-height:18px;margin-top:6px}

.saved-list{list-style:none;margin:8px 0 0;padding:0;max-height:200px;overflow-y:auto}
.saved-list li{display:flex;align-items:center;gap:8px;padding:7px 9px;border:1px solid var(--line);border-radius:8px;margin-bottom:6px;font-size:.8rem}
.saved-list .s-main{flex:1;min-width:0}
.saved-list .s-name{font-weight:600;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.saved-list .s-meta{color:var(--muted);font-size:.72rem}
.saved-empty{font-size:.8rem;color:var(--muted);font-style:italic}

/* ---------- the printable document ---------- */
.doc-wrap{display:flex;justify-content:center}
.doc{background:#fff;width:210mm;min-height:297mm;padding:16mm 15mm;box-shadow:0 6px 28px rgba(4,41,62,.14);position:relative;overflow:hidden}
@media (max-width:1080px){.doc{width:100%;min-height:0;padding:22px 18px}}

.doc-head{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;border-bottom:3px solid var(--primary-color);padding-bottom:14px}
.doc-head .co{display:flex;gap:12px;align-items:flex-start}
.doc-head .co img{width:56px;height:56px;object-fit:contain;flex-shrink:0}
.doc-head .co h1{font-size:1.3rem;color:var(--primary-color);line-height:1.2}
.doc-head .co p{margin:2px 0 0;font-size:.74rem;color:var(--muted)}
.co-contact{margin-top:5px;font-size:.72rem;color:var(--muted);line-height:1.55}
.co-contact span{display:block}
.doc-title{text-align:right;flex-shrink:0}
.doc-title h2{font-size:1.5rem;letter-spacing:.06em;color:var(--ocean-deep);text-transform:uppercase}
.doc-title .no{margin-top:6px;font-size:.78rem;color:var(--muted);line-height:1.7}
.doc-title .no b{color:var(--text-dark);font-weight:600}

.pill{display:inline-block;padding:4px 12px;border-radius:999px;font-size:.7rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin-top:8px}
.pill.paid{background:#e6f7ec;color:#1b7a43;border:1px solid #9fdcb8}
.pill.deposit{background:#fff5e0;color:#a35c00;border:1px solid #f2cf8f}
.pill.unpaid{background:#fdecea;color:#b3261e;border:1px solid #f2b8b3}

.grid2{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:18px}
@media (max-width:560px){.grid2{grid-template-columns:1fr;gap:14px}}
.block h3{font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--aqua);margin-bottom:7px}
.kv{font-size:.83rem;line-height:1.7}
/* Flex rows give each line a hanging indent, so a long value — a full airport
   address, say — wraps under itself instead of back beneath its own label. */
.kv .r,.pay-line .r{display:flex;gap:12px;align-items:baseline}
.kv .k,.pay-line .k{color:var(--muted);flex:0 0 auto;min-width:96px}
.kv .v,.pay-line .v{font-weight:600;min-width:0}
.kv .guest-name{font-size:1.02rem;font-weight:700;display:block;margin-bottom:6px}

.sec-title{font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--aqua);margin:22px 0 8px}
table.tbl{width:100%;border-collapse:collapse;font-size:.83rem}
table.tbl th{text-align:left;background:var(--sand-2);color:var(--ocean-deep);font-family:var(--font-heading);font-size:.7rem;letter-spacing:.07em;text-transform:uppercase;padding:8px 10px;border-bottom:1px solid var(--line)}
table.tbl td{padding:9px 10px;border-bottom:1px solid var(--line);vertical-align:top}
table.tbl td.r,table.tbl th.r{text-align:right}
table.tbl .time-col{white-space:nowrap;font-weight:700;color:var(--primary-color);width:76px}
table.tbl .note{display:block;color:var(--muted);font-size:.76rem;margin-top:2px}

.totals{margin-top:12px;display:flex;justify-content:flex-end}
.totals table{font-size:.86rem;min-width:290px}
.totals td{padding:6px 10px}
.totals td.lbl{color:var(--muted);text-align:right}
.totals td.val{text-align:right;font-weight:600;white-space:nowrap}
.totals tr.grand td{border-top:2px solid var(--primary-color);padding-top:10px;font-size:1.08rem;font-weight:800;color:var(--primary-color)}
.totals tr.bal td{color:var(--secondary-color);font-weight:800}

.paybox{position:relative;margin-top:16px;background:var(--bg-light);border:1px solid var(--line);border-left:4px solid var(--aqua);border-radius:8px;padding:12px 210px 12px 14px;font-size:.82rem}
.paybox h3{font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--aqua);margin-bottom:6px}
.paybox .pay-line{line-height:1.7}
.paybox .pay-line .k{min-width:132px}

.notes{margin-top:16px;font-size:.78rem;color:var(--muted);line-height:1.7;white-space:pre-line}
.doc-foot{margin-top:22px;padding-top:12px;border-top:1px solid var(--line);font-size:.72rem;color:var(--muted);text-align:center;line-height:1.7}
.doc-foot b{color:var(--primary-color)}

/* The stamp sits in the payment box's own empty right-hand side, so it can
   never land on top of the service details the way a page-absolute stamp did. */
.stamp{position:absolute;top:50%;right:18px;transform:translateY(-50%) rotate(-11deg);border:3px double #1b7a43;color:#1b7a43;font-family:var(--font-heading);font-weight:800;font-size:1.12rem;letter-spacing:.1em;padding:6px 14px;border-radius:8px;opacity:.5;pointer-events:none;text-transform:uppercase;white-space:nowrap}
.stamp.unpaid{border-color:#b3261e;color:#b3261e}
.stamp.deposit{border-color:#a35c00;color:#a35c00}
@media (max-width:560px){.stamp{display:none}.paybox{padding-right:14px}}

/* guest view */
.guest-bar{background:var(--primary-color);color:#fff;padding:12px 18px;display:flex;align-items:center;justify-content:center;gap:14px;flex-wrap:wrap;font-size:.88rem}
.guest-bar .tb-btn{background:#fff;color:var(--primary-color);border-color:#fff}
.guest-bar .tb-btn:hover{background:#eaf4fa}
body.guest-view .editor,body.guest-view .topbar{display:none}
body.guest-view .layout{grid-template-columns:1fr;padding:18px}
body:not(.guest-view) .guest-bar{display:none}

/* ---------- print ---------- */
@media print{
  @page{size:A4;margin:10mm}
  /* Nearly every size in the document is in rem, which tracks the ROOT font
     size, not body — so this is the one lever that scales the whole sheet.
     14/16 buys the headroom a one-service booking needs to stay on one page. */
  html{font-size:14px}
  body{background:#fff;font-size:12px}
  .topbar,.editor,.guest-bar,.no-print{display:none!important}
  /* .doc-wrap is a centering flexbox on screen. Left as flex for print, .doc
     becomes a flex item that shrink-wraps to its content and floats in the
     middle of the sheet, so the margins drift with whatever is on the page.
     Block layout plus a full-width doc pins it to the @page margin exactly. */
  /* body.guest-view .layout sets its own padding and outranks a bare .layout
     selector, so printing from a guest link inset the whole sheet by a further
     18px. Both selectors are matched here so the page margin is the only inset. */
  .layout,body.guest-view .layout{display:block;padding:0;max-width:none}
  .doc-wrap{display:block}
  /* overflow must go visible: the screen rule clips, and a long booking has to
     be allowed to fragment onto a second sheet rather than be cut off. */
  .doc{width:100%;min-height:0;margin:0;padding:0;box-shadow:none;overflow:visible}
  .doc,.doc *{-webkit-print-color-adjust:exact;print-color-adjust:exact}
  .stamp{display:block}
  /* A one-service booking has to land on a single sheet, so the whole
     document tightens up for print without dropping anything. */
  .doc-head{padding-bottom:9px}
  .doc-head .co img{width:46px;height:46px}
  .doc-title h2{font-size:1.32rem}
  .doc-title .no{margin-top:4px;line-height:1.55}
  .pill{margin-top:5px}
  .co-contact{line-height:1.45}
  .grid2{margin-top:10px;gap:14px}
  .block h3{margin-bottom:4px}
  .kv{line-height:1.5}
  .kv .guest-name{margin-bottom:3px}
  .sec-title{margin:10px 0 4px}
  table.tbl th,table.tbl td{padding:4px 8px}
  .totals{margin-top:6px}
  .totals td{padding:3px 8px}
  .totals tr.grand td{padding-top:7px}
  .paybox{margin-top:10px;padding:8px 200px 8px 11px}
  .paybox .pay-line{line-height:1.5}
  .notes{margin-top:9px;line-height:1.5}
  .doc-foot{margin-top:11px;padding-top:8px;line-height:1.5}
  table.tbl tr{page-break-inside:avoid}
  .paybox,.totals,.notes,.doc-foot,.grid2{page-break-inside:avoid}
}
</style>
</head>
<body>

<header class="topbar">
  <div class="brand"><img src="/src/assets/bali-real-vacation-logo.webp" alt="">Booking Receipt &amp; Itinerary</div>
  <div class="spacer"></div>
  <button class="tb-btn" id="btn-new"><i class="fa-solid fa-file-circle-plus"></i> New</button>
  <button class="tb-btn" id="btn-save"><i class="fa-solid fa-floppy-disk"></i> Save</button>
  <button class="tb-btn" id="btn-copy"><i class="fa-solid fa-link"></i> Copy guest link</button>
  <button class="tb-btn wa" id="btn-wa"><i class="fa-brands fa-whatsapp"></i> Send on WhatsApp</button>
  <button class="tb-btn primary" id="btn-print"><i class="fa-solid fa-file-pdf"></i> Save as PDF</button>
</header>

<div class="guest-bar">
  <span id="guest-bar-text">Your booking receipt from Bali Real Vacation.</span>
  <button class="tb-btn" onclick="window.print()"><i class="fa-solid fa-file-pdf"></i> <span id="guest-bar-btn">Download PDF</span></button>
</div>

<div class="layout">

  <!-- ============ EDITOR (operator only, never printed) ============ -->
  <aside class="editor" id="editor">
    <h2>Booking details</h2>
    <p class="hint">Fill this in and the document on the right updates live. Nothing is uploaded — the receipt travels inside the link you share.</p>

    <fieldset>
      <legend>Document</legend>
      <div class="row">
        <div class="fg">
          <label for="f-type">Document type</label>
          <select id="f-type">
            <option value="receipt">Receipt (payment received)</option>
            <option value="confirmation">Booking confirmation</option>
            <option value="invoice">Invoice (payment due)</option>
          </select>
        </div>
        <div class="fg">
          <label for="f-lang">Language</label>
          <select id="f-lang">
            <option value="en">English</option>
            <option value="id">Bahasa Indonesia</option>
            <option value="zh">中文</option>
          </select>
        </div>
      </div>
      <div class="row">
        <div class="fg"><label for="f-no">Document no.</label><input type="text" id="f-no"></div>
        <div class="fg"><label for="f-issued">Issue date</label><input type="date" id="f-issued"></div>
      </div>
    </fieldset>

    <fieldset>
      <legend>Guest</legend>
      <div class="fg"><label for="f-guest-name">Full name</label><input type="text" id="f-guest-name" placeholder="Name as it should appear"></div>
      <div class="row">
        <div class="fg"><label for="f-guest-wa">WhatsApp number</label><input type="tel" id="f-guest-wa" placeholder="+61 400 000 000"></div>
        <div class="fg"><label for="f-guest-pax">Guests (pax)</label><input type="number" id="f-guest-pax" min="1" value="2"></div>
      </div>
      <div class="row">
        <div class="fg"><label for="f-guest-email">Email (optional)</label><input type="email" id="f-guest-email"></div>
        <div class="fg"><label for="f-guest-country">Country (optional)</label><input type="text" id="f-guest-country"></div>
      </div>
    </fieldset>

    <fieldset>
      <legend>Service</legend>
      <div class="fg">
        <label for="f-preset">Quick fill from our price list</label>
        <select id="f-preset"><option value="">Choose a service…</option></select>
      </div>
      <div class="fg"><label for="f-svc-title">Service name</label><input type="text" id="f-svc-title" placeholder="e.g. Airport Transfer — DPS to Ubud"></div>
      <div class="row">
        <div class="fg"><label for="f-svc-date">Service date</label><input type="date" id="f-svc-date"></div>
        <div class="fg"><label for="f-svc-time">Pickup time</label><input type="time" id="f-svc-time"></div>
      </div>
      <div class="fg"><label for="f-svc-pickup">Pickup point</label><input type="text" id="f-svc-pickup" placeholder="Ngurah Rai Airport (DPS), Arrivals Hall"></div>
      <div class="fg"><label for="f-svc-dropoff">Drop-off / destination</label><input type="text" id="f-svc-dropoff" placeholder="Hotel name &amp; area"></div>
      <div class="row">
        <div class="fg"><label for="f-svc-flight">Flight no. (optional)</label><input type="text" id="f-svc-flight" placeholder="JQ 43"></div>
        <div class="fg"><label for="f-svc-vehicle">Vehicle</label><input type="text" id="f-svc-vehicle" placeholder="Toyota Avanza (A/C)"></div>
      </div>
      <div class="row">
        <div class="fg"><label for="f-svc-driver">Driver / guide</label><input type="text" id="f-svc-driver" placeholder="Ketut"></div>
        <div class="fg"><label for="f-svc-driver-wa">Driver WhatsApp</label><input type="tel" id="f-svc-driver-wa" placeholder="+62 823 1779 4462"></div>
      </div>
    </fieldset>

    <fieldset>
      <legend>Itinerary</legend>
      <div id="itin-rows"></div>
      <button class="mini-btn" id="btn-add-itin"><i class="fa-solid fa-plus"></i> Add itinerary stop</button>
      <div class="fg" style="margin-top:12px"><label for="f-incl">What is included (one per line)</label><textarea id="f-incl" placeholder="Private A/C transport&#10;English-speaking driver&#10;Cold drinks &amp; bottled water"></textarea></div>
    </fieldset>

    <fieldset>
      <legend>Charges</legend>
      <div class="fg" style="max-width:150px"><label for="f-cur">Currency</label>
        <select id="f-cur"><option value="IDR">IDR (Rp)</option><option value="USD">USD ($)</option><option value="AUD">AUD (A$)</option></select>
      </div>
      <div id="item-rows"></div>
      <button class="mini-btn" id="btn-add-item"><i class="fa-solid fa-plus"></i> Add line item</button>
    </fieldset>

    <fieldset>
      <legend>Payment</legend>
      <div class="row">
        <div class="fg">
          <label for="f-pay-status">Status</label>
          <select id="f-pay-status">
            <option value="paid">Paid in full</option>
            <option value="deposit">Deposit paid</option>
            <option value="unpaid">Payment due</option>
          </select>
        </div>
        <div class="fg">
          <label for="f-pay-method">Method</label>
          <select id="f-pay-method">
            <option value="cash_driver">Cash to driver</option>
            <option value="cash_office">Cash</option>
            <option value="bank">Bank transfer</option>
            <option value="paypal">PayPal</option>
            <option value="card">Credit / debit card</option>
            <option value="pending">Not yet paid</option>
          </select>
        </div>
      </div>
      <div class="row">
        <div class="fg"><label for="f-pay-paid">Amount received</label><input type="number" id="f-pay-paid" min="0" step="any"></div>
        <div class="fg"><label for="f-pay-date">Payment date</label><input type="date" id="f-pay-date"></div>
        <div class="fg"><label for="f-pay-received-by">Received by / to be paid to</label><input type="text" id="f-pay-received-by" placeholder="Ketut (driver)"></div>
      </div>
      <div class="fg"><label for="f-pay-cash-idr">Cash amount in IDR <span style="font-weight:400">— optional, for guests paying cash</span></label><input type="number" id="f-pay-cash-idr" min="0" step="1000" placeholder="e.g. 300000"></div>
      <div class="fg"><label for="f-notes">Notes / terms shown on the document</label><textarea id="f-notes"></textarea></div>
    </fieldset>

    <div class="warn" id="warn" hidden></div>

    <fieldset>
      <legend>Saved bookings <span style="font-weight:500;text-transform:none;letter-spacing:0;color:var(--muted)">(this device only)</span></legend>
      <ul class="saved-list" id="saved-list"></ul>
      <button class="mini-btn" id="btn-sync" style="margin-top:8px"><i class="fa-solid fa-cloud-arrow-down"></i> Fetch bookings issued on other devices</button>
      <div class="status-msg" id="status-msg"></div>
      <div class="fg" style="margin-top:12px">
        <label for="f-key">Issuer key <span style="font-weight:400">— only needed if you set RECEIPT_KEY in Convex</span></label>
        <input type="password" id="f-key" autocomplete="off" placeholder="leave blank if unused">
      </div>
    </fieldset>
  </aside>

  <!-- ============ THE DOCUMENT ============ -->
  <div class="doc-wrap">
    <article class="doc" id="doc">
      <header class="doc-head">
        <div class="co">
          <img src="/src/assets/bali-real-vacation-logo.webp" alt="Bali Real Vacation">
          <div>
            <h1>Bali Real Vacation</h1>
            <p id="d-co-tagline">Your trusted travel partner in Bali &amp; Nusa Penida</p>
            <div class="co-contact">
