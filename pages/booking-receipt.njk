    mDue:{cash_driver:"现金，付予您的司机",cash_office:"现金",bank:"银行转账",paypal:"PayPal",card:"信用卡 / 借记卡",pending:"待安排"},
    payTo:"付款对象", dueWhen:"付款时间", dueOnDay:"服务当天出发前",
    cashIdr:"现金金额（印尼盾）", cashIdrNote:"请准备好该金额的现金",
