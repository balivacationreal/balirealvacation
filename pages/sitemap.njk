---
permalink: "/sitemap.xml"
eleventyExcludeFromCollections: true
---
{#- Generated sitemap. The URL list comes from the `sitemapUrls` collection in
    .eleventy.js, so every page — English, Indonesian and Chinese — is listed
    the moment it is built, and each <url> carries xhtml:link alternates naming
    its translations. Weightings live in _data/sitemapMeta.js.
    Do not hand-edit the output; edit those two files. -#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for entry in collections.sitemapUrls %}
  <url>
    <loc>{{ entry.loc }}</loc>
    {%- if entry.lastmod %}
    <lastmod>{{ entry.lastmod }}</lastmod>
    {%- endif %}
    <changefreq>{{ entry.changefreq }}</changefreq>
    <priority>{{ entry.priority }}</priority>
    {%- for alt in entry.alternates %}
    <xhtml:link rel="alternate" hreflang="{{ alt.lang }}" href="{{ alt.href }}"/>
    {%- endfor %}
    {%- if entry.xDefault %}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ entry.xDefault }}"/>
    {%- endif %}
  </url>
{%- endfor %}
</urlset>
