                    </div>

                    <p class="price-note"><i class="fa-solid fa-circle-info"></i><span>{% endraw %}{{ ui.price_note[lang] or ui.price_note.en }}{% raw %}</span></p>
                    <a href="https://wa.me/6282317794462?text=Hello%20Bali%20Real%20Vacation!%20I%20would%20like%20to%20book%20the%20West%20Nusa%20Penida%20Tour." class="btn" target="_blank" rel="noopener">
                        <i class="fa-brands fa-whatsapp" style="margin-right:8px;"></i> Book Now via WhatsApp
                    </a>
                    <ul class="inclusions-list">
                        <li><i class="fa-solid fa-circle-check" style="color:#25D366"></i> Private A/C Transport (Bali & Penida)</li>
                        <li><i class="fa-solid fa-circle-check" style="color:#25D366"></i> Return Fast Boat Tickets</li>
