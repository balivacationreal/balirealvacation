{% block content %}{% raw %}
<section class="tour-hero">
    <h1>西佩尼达岛之旅</h1>
    <p style="font-size:1.2rem;margin-top:10px;">壮丽的悬崖、纯净的海滩与隐藏的宝藏</p>
</section>

<main class="tour-container">
    <div class="tour-grid">
        <div class="tour-description">
            <p style="font-size:1.1rem;margin-bottom:30px;color:#444;">逃离平凡，通过我们独家的西佩尼达岛私人一日游，发现一个隐藏的天堂。您将被壮丽的悬崖、纯净的海滩和秘密的自然宝藏所吸引。我们负责处理每一个细节——从酒店接送到快艇航行——让您只需尽情享受印度尼西亚最壮观的目的地之一。</p>
            
            <h2 class="section-heading">行程安排</h2>
            <ul class="itinerary-list">
                <li class="itinerary-item">
                    <div class="itinerary-icon"><i class="fa-solid fa-car"></i></div>
                    <div class="itinerary-details"><h3>06:30 AM – 酒店接送</h3><p>从您的巴厘岛酒店乘坐私人专车前往萨努尔 (Sanur) 港口。</p></div>
                </li>
                <li class="itinerary-item">
                    <div class="itinerary-icon"><i class="fa-solid fa-ship"></i></div>
                    <div class="itinerary-details"><h3>07:30 AM – 快艇前往佩尼达岛</h3><p>乘坐高速快艇穿过海峡前往岛屿（约 35 分钟）。</p></div>
                </li>
                <li class="itinerary-item">
                    <div class="itinerary-icon"><i class="fa-solid fa-water"></i></div>
                    <div class="itinerary-details"><h3>09:00 AM – 天神浴池 (Angel's Billabong)</h3><p>探索刻在岩壁上的令人惊叹的天然无边泳池。</p></div>
                </li>
                <li class="itinerary-item">
                    <div class="itinerary-icon"><i class="fa-solid fa-camera"></i></div>
                    <div class="itinerary-details"><h3>11:00 AM – 破碎沙滩 (Broken Beach)</h3><p>惊叹于壮观的圆形海湾及其天然的岩石拱门。</p></div>
                </li>
                <li class="itinerary-item">
                    <div class="itinerary-icon"><i class="fa-solid fa-mountain-sun"></i></div>
                    <div class="itinerary-details"><h3>12:00 PM – 精灵坠崖 (Kelingking Beach)</h3><p>观赏标志性的霸王龙形悬崖，拍摄令人惊叹的全景照片。</p></div>
                </li>
                <li class="itinerary-item">
                    <div class="itinerary-icon"><i class="fa-solid fa-utensils"></i></div>
                    <div class="itinerary-details"><h3>01:00 PM – 午餐</h3><p>享用美味的当地午餐（提供巴厘岛或西式美食）。</p></div>
                </li>
                <li class="itinerary-item">
                    <div class="itinerary-icon"><i class="fa-solid fa-umbrella-beach"></i></div>
                    <div class="itinerary-details"><h3>02:30 PM – 水晶湾 (Crystal Bay)</h3><p>在这个被棕榈树环绕的美丽海滩放松、游泳并享受阳光。</p></div>
                </li>
                <li class="itinerary-item">
                    <div class="itinerary-icon"><i class="fa-solid fa-ship"></i></div>
                    <div class="itinerary-details"><h3>04:30 PM – 返回巴厘岛</h3><p>乘坐快艇返回萨努尔港口，然后私人专车送您回酒店。</p></div>
                </li>
            </ul>

            <div class="tour-gallery">
                <h2>旅游图集</h2>
                <!-- same images as english -->
                <div class="gallery-grid">
                    <div class="gallery-item"><img src="/src/assets/penida/angels-billabong.webp" alt="Angel's Billabong" fetchpriority="high" width="300" height="225"></div>
                    <div class="gallery-item"><img src="/src/assets/penida/broken-beach-view.webp" alt="Broken Beach" loading="lazy" width="300" height="225"></div>
                    <div class="gallery-item"><img src="/src/assets/penida/broken-beach-top-view.webp" alt="Broken Beach" loading="lazy" width="300" height="225"></div>
                    <div class="gallery-item"><img src="/src/assets/penida/kelingking-beach-view.webp" alt="Kelingking Beach" loading="lazy" width="300" height="225"></div>
                    <div class="gallery-item"><img src="/src/assets/penida/down-to-kelingking-beach.webp" alt="Trekking down to Kelingking" loading="lazy" width="300" height="225"></div>
                    <div class="gallery-item"><img src="/src/assets/penida/white-sand-kelingking-beach.webp" alt="Kelingking sand" loading="lazy" width="300" height="225"></div>
                    <div class="gallery-item"><img src="/src/assets/penida/crystal-bay-nusa-penida.webp" alt="Crystal Bay" loading="lazy" width="300" height="225"></div>
                    <div class="gallery-item"><img src="/src/assets/penida/crystal-bay.webp" alt="Crystal Bay top view" loading="lazy" width="300" height="225"></div>
                </div>
            </div>

            <div class="faq-section">
                <h2>常见问题解答 (FAQ)</h2>
                <div class="faq-item">
                    <button class="faq-question">西佩尼达岛的旅游价格包括哪些项目？ <i class="fa-solid fa-chevron-down faq-chevron"></i></button>
                    <div class="faq-answer"><p>全包价格涵盖往返萨努尔港口的私人空调车接送、往返快艇票、全天英语向导、所有目的地门票（精灵坠崖、破碎沙滩、天神浴池、水晶湾）以及当地午餐。</p></div>
                </div>
                <div class="faq-item">
                    <button class="faq-question">从巴厘岛到佩尼达岛的快艇需要多长时间？ <i class="fa-solid fa-chevron-down faq-chevron"></i></button>
                    <div class="faq-answer"><p>从萨努尔港出发的快艇大约需要 30–45 分钟，具体取决于海况。我们早上 07:30 出发，大约 08:30 抵达佩尼达岛。</p></div>
                </div>
                <div class="faq-item">
                    <button class="faq-question">什么时候是游览佩尼达岛的最佳季节？ <i class="fa-solid fa-chevron-down faq-chevron"></i></button>
                    <div class="faq-answer"><p>旱季（5 月至 10 月）是理想的时间——天空晴朗、海面平静，摄影条件极佳。在此期间，道路和海滩最容易通行。</p></div>
                </div>
                <div class="faq-item">
                    <button class="faq-question">行程包括徒步下到精灵坠崖海滩吗？ <i class="fa-solid fa-chevron-down faq-chevron"></i></button>
                    <div class="faq-answer"><p>我们参观标志性的霸王龙悬崖观景台。选择徒步下陡峭的悬崖到海滩（单程约 1 小时）由您自行决定——仅建议体力好的客人尝试。</p></div>
                </div>
                <div class="faq-item">
                    <button class="faq-question">我应该提前多久预订西佩尼达岛之旅？ <i class="fa-solid fa-chevron-down faq-chevron"></i></button>
                    <div class="faq-answer"><p>我们建议您至少提前 2-3 天预订，特别是在旺季（6月至8月）。通过 WhatsApp 给我们发消息，我们将立即确认空位并安排所有细节。</p></div>
                </div>
            </div>
        </div>

        <aside>
            <div class="pricing-card">
                <h3 style="color:var(--primary-color);font-size:1.5rem;margin-bottom:10px;">套餐价格</h3>
