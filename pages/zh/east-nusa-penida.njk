{% block content %}{% raw %}
<section class="tour-hero">
    <h1>东佩尼达岛之旅</h1>
    <p style="font-size:1.2rem;margin-top:10px;">全景海岸与标志性拍照打卡地</p>
</section>

<main class="tour-container">
    <div class="tour-grid">
        <div class="tour-description">
            <p style="font-size:1.1rem;margin-bottom:30px;color:#444;">前往佩尼达岛壮丽的东海岸。这个私人一日游专为那些寻求令人惊叹的海岸风光、标志性拍照机会和原始自然美的游客而设计。从钻石海滩闪闪发光的白色沙滩到著名的 Molenteng 树屋，我们经验丰富的团队将确保您享受一段舒适、安全且难忘的旅程。</p>
            
            <h2 class="section-heading">行程安排</h2>
            <ul class="itinerary-list">
                <li class="itinerary-item">
                    <div class="itinerary-icon"><i class="fa-solid fa-car"></i></div>
                    <div class="itinerary-details"><h3>06:30 AM – 酒店接送</h3><p>从您的巴厘岛酒店乘坐私人专车前往萨努尔 (Sanur) 港口。</p></div>
                </li>
                <li class="itinerary-item">
                    <div class="itinerary-icon"><i class="fa-solid fa-ship"></i></div>
                    <div class="itinerary-details"><h3>07:30 AM – 快艇前往佩尼达岛</h3><p>乘坐高速快艇穿过美丽的巴东海峡 (Badung Strait)。</p></div>
                </li>
                <li class="itinerary-item">
                    <div class="itinerary-icon"><i class="fa-solid fa-umbrella-beach"></i></div>
                    <div class="itinerary-details"><h3>09:30 AM – 阿图海滩 (Atuh Beach)</h3><p>抵达并探索美丽、宁静的阿图海滩。</p></div>
                </li>
                <li class="itinerary-item">
                    <div class="itinerary-icon"><i class="fa-solid fa-camera"></i></div>
                    <div class="itinerary-details"><h3>10:30 AM – 千岛观景台 (Raja Lima)</h3><p>欣赏令人叹为观止的海景全貌。</p></div>
                </li>
                <li class="itinerary-item">
                    <div class="itinerary-icon"><i class="fa-solid fa-tree"></i></div>
                    <div class="itinerary-details"><h3>11:30 AM – 树屋 (Molenteng Tree House)</h3><p>参观著名的网红树屋，拍摄标志性的度假照片。</p></div>
                </li>
                <li class="itinerary-item">
                    <div class="itinerary-icon"><i class="fa-solid fa-utensils"></i></div>
                    <div class="itinerary-details"><h3>01:30 PM – 午餐</h3><p>享用美味的当地午餐（提供巴厘岛或西式美食）。</p></div>
                </li>
                <li class="itinerary-item">
                    <div class="itinerary-icon"><i class="fa-solid fa-gem"></i></div>
                    <div class="itinerary-details"><h3>02:30 PM – 钻石海滩 (Diamond Beach)</h3><p>沿着令人惊叹的白色沙滩和高耸的喀斯特岩层漫步。</p></div>
                </li>
                <li class="itinerary-item">
                    <div class="itinerary-icon"><i class="fa-solid fa-car-side"></i></div>
                    <div class="itinerary-details"><h3>05:30 PM – 返回巴厘岛</h3><p>乘坐快艇返回萨努尔港口，然后私人专车送您回酒店。</p></div>
                </li>
            </ul>

            <!-- Gallery... -->
            <div class="tour-gallery">
                <h2>旅游图集</h2>
                <!-- same images as english -->
                <div class="gallery-grid">
                    <div class="gallery-item"><img src="/src/assets/penida/diamond-beach.webp" alt="Diamond Beach" fetchpriority="high" width="300" height="225"></div>
                    <div class="gallery-item"><img src="/src/assets/penida/diamond-beach-swing.webp" alt="Swing at Diamond Beach" loading="lazy" width="300" height="225"></div>
                    <div class="gallery-item"><img src="/src/assets/penida/tree-house.webp" alt="Molenteng Tree House" loading="lazy" width="300" height="225"></div>
                    <div class="gallery-item"><img src="/src/assets/penida/tree-house-view.webp" alt="View from Molenteng Tree House" loading="lazy" width="300" height="225"></div>
                    <div class="gallery-item"><img src="/src/assets/penida/nusa-penida-thousand-island-view-point.webp" alt="Thousand Islands viewpoint" loading="lazy" width="300" height="225"></div>
                    <div class="gallery-item"><img src="/src/assets/penida/atuh-beach.webp" alt="Atuh Beach" loading="lazy" width="300" height="225"></div>
                    <div class="gallery-item"><img src="/src/assets/penida/stunning-atuh-beach.webp" alt="Aerial view of Atuh Beach" loading="lazy" width="300" height="225"></div>
                    <div class="gallery-item"><img src="/src/assets/penida/thousand-islands.webp" alt="Thousand Islands rock formations" loading="lazy" width="300" height="225"></div>
                </div>
            </div>

            <div class="faq-section">
                <h2>常见问题解答 (FAQ)</h2>
                <div class="faq-item">
                    <button class="faq-question">东佩尼达岛和西佩尼达岛行程有什么区别？ <i class="fa-solid fa-chevron-down faq-chevron"></i></button>
                    <div class="faq-answer"><p>西佩尼达岛以精灵坠崖 (Kelingking Beach) 和破碎沙滩 (Broken Beach) 等戏剧性的悬崖地貌而闻名。东佩尼达岛则提供全景海岸风光、钻石海滩、阿图海滩和标志性的树屋——通常游客较少，更加宁静。</p></div>
                </div>
                <div class="faq-item">
                    <button class="faq-question">我可以在一天内结合东西佩尼达岛的行程吗？ <i class="fa-solid fa-chevron-down faq-chevron"></i></button>
                    <div class="faq-answer"><p>由于岛上的路况，一天内结合两岸行程会非常疲惫。我们强烈建议将它们作为分开的一日游预订，以充分享受体验并保持舒适。</p></div>
                </div>
                <div class="faq-item">
                    <button class="faq-question">钻石海滩值得一游吗？ <i class="fa-solid fa-chevron-down faq-chevron"></i></button>
                    <div class="faq-answer"><p>绝对值得。钻石海滩一直位列印度尼西亚最美丽的海滩之列。白色的沙滩、清澈碧绿的海水以及醒目的菱形喀斯特岩层使其成为世界级的摄影胜地。</p></div>
                </div>
                <div class="faq-item">
                    <button class="faq-question">去东佩尼达岛旅行我应该带什么？ <i class="fa-solid fa-chevron-down faq-chevron"></i></button>
                    <div class="faq-answer"><p>请穿着舒适的包趾鞋（以便下台阶）、对珊瑚礁安全的防晒霜、帽子、相机和一些现金。我们全天提供瓶装水和午餐。</p></div>
                </div>
                <div class="faq-item">
                    <button class="faq-question">东佩尼达岛的旅游价格包括哪些项目？ <i class="fa-solid fa-chevron-down faq-chevron"></i></button>
                    <div class="faq-answer"><p>全包价格涵盖私人空调车接送、往返萨努尔的快艇票、英语向导、所有景点门票（钻石海滩、阿图海滩、千岛观景台、树屋）以及当地午餐。</p></div>
                </div>
            </div>
        </div>

        <aside>
            <div class="pricing-card">
                <h3 style="color:var(--primary-color);font-size:1.5rem;margin-bottom:10px;">套餐价格</h3>
                <p style="color:#666;font-size:.9rem;margin-bottom:20px;">全包私人行程</p>
                <div class="price-tier">
